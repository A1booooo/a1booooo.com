[Unit]
Description=Deploy the published mysite build from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=mysite-deploy
Group=mysite-deploy
StateDirectory=mysite-deploy
StateDirectoryMode=0700
ReadWritePaths=/www/wwwroot/mysite-releases
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
UMask=0022
TimeoutStartSec=90
ExecStart=/usr/local/libexec/mysite/pull-mysite.sh
